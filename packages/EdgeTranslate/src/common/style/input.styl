color-primary = #a9471d;
control-border = #6b5b38;
control-bg = #fffefa;
focus-ring = #a9471d;

scale = 1.3;
.radio, .checkbox {
    position: relative;
    width: 21px;
    height: 21px;
    margin: 0 8px 0 0;
    vertical-align: middle;
    background: control-bg;
    border: 1px solid control-border;
    cursor: pointer;
}
.radio { border-radius: 50%; }
.checkbox { border-radius: 4px; }
.radio:checked, .checkbox:checked { accent-color: color-primary; }
.radio:focus-visible, .checkbox:focus-visible, .switch:focus-visible {
    outline: 3px solid focus-ring;
    outline-offset: 2px;
}
.radio:disabled, .checkbox:disabled, .switch:disabled { cursor: not-allowed; opacity: .7; }

.switch {
    appearance: none;
    position: relative;
    flex: 0 0 44px;
    width: 44px;
    height: 26px;
    margin: 0;
    border: 1px solid control-border;
    border-radius: 16px;
    background: #d7c9a6;
    cursor: pointer;
}
.switch:after {
    content: "";
    position: absolute;
    top: 2px;
    left: 2px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #fffefa;
    transition: transform .18s ease;
}
.switch:checked { border-color: #17324d; background: #17324d; }
.switch:checked:after { transform: translateX(18px); background: #ffb010; }
