@import '../common/style/input.styl';

canvas = #fff0cc;
surface = #fff9e8;
ink = #2b251a;
muted = #655a43;
border = #6b5b38;
accent = #a9471d;
saffron = #ffb010;
night = #0b1a29;
navy = #17324d;
dark-muted = #d6bc7c;

html, body {
    margin: 0;
    min-height: 100%;
    background: canvas;
    color: ink;
    font: 400 16px/1.55 system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang TC", "Microsoft JhengHei", "Noto Sans TC", sans-serif;
}
#option {
    box-sizing: border-box;
    width: 100%;
    max-width: 920px;
    margin: 24px auto;
    padding: 24px 6%;
    border: 1px solid border;
    border-radius: 16px;
    background: surface;
    box-shadow: 0 12px 32px rgba(43, 37, 26, .12);
}
header { display: flex; align-items: center; gap: 12px; margin: 0 0 28px; color: accent; }
header img { width: 48px; height: 48px; object-fit: contain; }
header h1 { margin: 0; font-size: 24px; line-height: 1.25; font-weight: 700; }
.content { min-width: 0; }
.setting-title { margin: 28px 0 8px; font-size: 18px; line-height: 1.4; font-weight: 700; color: ink; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin: 10px 0; }
.column { display: flex; align-items: center; gap: 8px; flex: 1 1 0; min-width: 0; }
.reset-column { width: 100%; align-items: center; gap: 16px; }
.reset-copy { flex: 1 1 auto; line-height: 1.5; }
.reset-title { font-weight: 600; }
.reset-description { margin-top: 4px; color: muted; font-size: 14px; }
.checked-label, .radio-label { cursor: pointer; font-size: 16px; }
.checked-label { display: inline-flex; align-items: center; gap: 10px; }
.setting-title + .row, .setting-title + div { margin-top: 0; }
select, button { min-height: 42px; max-width: 100%; border: 1px solid border; border-radius: 8px; padding: 8px 12px; background: #fffefa; color: ink; font: inherit; }
select { min-width: 150px; }
button { background: saffron; border-color: navy; font-weight: 700; cursor: pointer; }
button:hover { filter: brightness(.95); }
.secondary-button { flex: 0 0 auto; background: surface; border-color: border; color: ink; font-size: 14px; }
.space { display: inline-block; width: 4px; }
:focus-visible { outline: 3px solid accent; outline-offset: 2px; }
footer { padding: 28px 0 8px; text-align: center; font-size: 14px; color: muted; overflow-wrap: anywhere; }
a { color: #71300f; }

.dark, .dark body { background: night !important; color: #fff9e8 !important; }
.dark #option { background: navy !important; border-color: dark-muted; color: #fff9e8 !important; }
.dark header, .dark .setting-title { color: #fff9e8; }
.dark .checked-label, .dark .radio-label, .dark footer, .dark .reset-description { color: dark-muted; }
.dark select { background: night; color: #fff9e8; border-color: dark-muted; }
.dark button { background: saffron; border-color: navy; color: ink; }
.dark .secondary-button { background: navy; color: #fff9e8; border-color: dark-muted; }
.dark a, .dark footer a { color: saffron; }
.dark .radio, .dark .checkbox { background-color: #fffefa; border-color: dark-muted; }
.dark .radio:checked, .dark .checkbox:checked { accent-color: saffron; }
.dark .switch { background: #655a43; border-color: dark-muted; }
.dark .switch:checked { background: saffron; border-color: saffron; }
.dark :focus-visible { outline-color: saffron; }

@media (max-width: 600px) {
    #option { margin: 0 auto; padding: 16px; border-radius: 0; }
    .row { align-items: flex-start; flex-wrap: wrap; gap: 10px; margin: 12px 0; }
    .column { flex: 1 1 100%; max-width: 100%; }
    .reset-column { flex-direction: column; align-items: stretch; }
    .reset-column button { align-self: flex-start; }
    select { min-width: 0; width: 100%; }
}
