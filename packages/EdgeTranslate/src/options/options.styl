@import '../common/style/input.styl';

lotus-bg = #f2ecbc;
lotus-surface = #f7f3d0;
lotus-surface-alt = #e9dfb5;
lotus-border = #c9c19f;
lotus-text = #545464;
lotus-muted = #716e61;
lotus-subtle = #8a8980;
lotus-accent = #4d699b;

tokyo-bg = #222436;
tokyo-surface = #2a2e45;
tokyo-border = #3b4261;
tokyo-text = #c8d3f5;
tokyo-muted = #b4c0e8;
tokyo-subtle = #828bb8;
tokyo-accent = #82aaff;

html, body {
    width: 100%;
    padding: 0;
    margin: 0;
    background-color: lotus-bg;
    color: lotus-text;
    // 시스템 기본 폰트 스택 적용
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, "Helvetica Neue", Arial, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    font-variant-ligatures: none;
    font-weight: 500;
}

#option {
    padding: 0 10%;
    margin: auto;
    max-width: 840px;
    margin: 0px auto;
    box-shadow: 0px 18px 44px rgba(84, 84, 100, 0.12);
    background-color: lotus-surface;
    border: 1px solid rgba(201, 193, 159, 0.75);
}

header {
    width: 100%;
    height: 25%;
    padding: 5% 0;
    font-size: 64px;
    font-weight: bold;
    color: lotus-accent;
    display: flex;
    align-items: center;
}

.row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    line-height: 4em;
    margin: 3% 5%;
    flex: 1 1;
}

.column {
    display: flex;
    align-items: center;
    min-width: 30%;
    max-width: 70%;
}

.reset-column {
    max-width: 100%;
    width: 100%;
    align-items: flex-start;
    gap: 16px;
}

.reset-copy {
    flex: 1 1 auto;
    line-height: 1.5;
}

.reset-title {
    font-size: medium;
    font-weight: 600;
}

.reset-description {
    margin-top: 6px;
    font-size: 14px;
    color: lotus-muted;
}

.secondary-button {
    border: 1px solid lotus-border;
    background: lotus-surface-alt;
    color: lotus-accent;
    border-radius: 8px;
    padding: 10px 16px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
}

.secondary-button:hover {
    background: lotus-bg;
}

.checked-label {
    cursor: pointer;
    font-size: medium;
    flex: 3 3 50%;
    justify-content: space-between;
}

.radio-label {
    cursor: pointer;
    font-size: medium;
}

.setting-title {
    font-size: large;
    font-weight: bold;
}

.space {
    display: inline-block;
    width: 5px;
}

footer {
    padding: 5% 0;
    text-align: center;
    font-size: medium;
    color: lotus-subtle;
}

// Dark Mode Styles
.dark {
    background-color: tokyo-bg !important;
    color: tokyo-text !important;
}

.dark #option {
    background-color: tokyo-surface !important;
    box-shadow: 0px 0px 50px rgba(0, 0, 0, 0.5) !important;
    color: tokyo-text !important;
    border-color: tokyo-border !important;
}

.dark header {
    color: tokyo-accent !important;
}

.dark .setting-title {
    color: tokyo-text !important;
}

.dark .checked-label, 
.dark .radio-label, 
.dark footer {
    color: tokyo-muted !important;
}

.dark .reset-description {
    color: tokyo-muted !important;
}

.dark footer a {
    color: tokyo-accent !important;
}

.dark select {
    background-color: tokyo-surface !important;
    color: tokyo-text !important;
    border: 1px solid tokyo-border !important;
}

.dark .secondary-button {
    background-color: tokyo-surface !important;
    border-color: tokyo-border !important;
    color: tokyo-accent !important;
}

.dark .secondary-button:hover {
    background-color: #303654 !important;
}

.dark .checkbox,
.dark .radio {
    background-color: tokyo-surface !important;
    border-color: tokyo-border !important;
}

.dark .switch {
    border-color: tokyo-border !important;
    background: tokyo-border !important;
}

.dark .switch:before {
    background-color: tokyo-border !important;
}

.dark .switch:after {
    background-color: tokyo-text !important;
    box-shadow: none !important;
}

.dark .switch:checked {
    border-color: tokyo-accent !important;
    background-color: tokyo-accent !important;
}
