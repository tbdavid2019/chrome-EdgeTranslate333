@import '../common/style/input.styl';

warm-canvas = #fff0cc;
warm-surface = #fff9e8;
warm-ink = #2b251a;
warm-muted = #655a43;
warm-border = #6b5b38;
warm-accent = #a9471d;
saffron = #ffb010;
navy-ground = #0b1a29;
navy-surface = #17324d;
dark-muted = #d6bc7c;

html, body {
    margin: 0;
    width: 100%;
    min-width: 320px;
    max-width: 440px;
    background: warm-canvas;
    color: warm-ink;
    font: 400 16px/1.5 system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang TC", "Microsoft JhengHei", "Noto Sans TC", sans-serif;
}

body { padding: 16px; box-sizing: border-box; }
.frame { padding: 16px; border: 1px solid warm-border; border-radius: 14px; background: warm-surface; }
.visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 12px 0; }
.col { flex: 1 1 0; min-width: 0; }
.selection { display: flex; justify-content: center; }
.switch-label { flex: 1; font-size: 16px; text-align: left; }
.popup-chevron { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform 180ms ease; }
#setting-switch[aria-expanded="true"] .popup-chevron { transform: rotate(180deg); }
@media (prefers-reduced-motion: reduce) { .popup-chevron { transition: none; } }

#exchange { border: 0; border-radius: 8px; padding: 8px; background: transparent; color: warm-accent; cursor: pointer; }
#exchange:disabled { color: warm-muted; cursor: not-allowed; }
#exchange svg { display: block; }
#setting-switch:focus-visible { color: warm-accent; }
select, #translate_input {
    min-height: 42px;
    width: 100%;
    border: 1px solid warm-border;
    border-radius: 8px;
    padding: 8px 10px;
    background: #fffefa;
    color: warm-ink;
    font: inherit;
}
#translate_input { flex: 1 1 auto; min-width: 0; }
#translateSubmit, .primary-button {
    min-height: 42px;
    min-width: 96px;
    flex: 0 0 auto;
    white-space: nowrap;
    border: 1px solid navy-surface;
    border-radius: 8px;
    padding: 8px 14px;
    background: saffron;
    color: warm-ink;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
}
#translateSubmit:hover, .primary-button:hover { filter: brightness(.95); }
:focus-visible { outline: 3px solid warm-accent; outline-offset: 2px; }
#hint_message { display: none; color: warm-accent; }
#setting-switch { width: 100%; justify-content: center; min-height: 44px; color: warm-muted; cursor: pointer; border: 1px solid warm-border; border-radius: 8px; background: transparent; }
#setting-switch:hover { color: warm-ink; }
#setting { display: none; margin: 12px 0; }
footer { margin-top: 12px; color: warm-muted; text-align: center; font-size: 14px; }

.dark, .dark body { background: navy-ground !important; color: #fff9e8 !important; }
.dark .frame { background: navy-surface !important; border-color: #d6bc7c; }
.dark select, .dark #translate_input { background: navy-ground; color: #fff9e8; border-color: #d6bc7c; }
.dark #translateSubmit, .dark .primary-button { background: saffron; border-color: navy-surface; color: warm-ink; }
.dark #exchange { color: saffron; }
.dark .popup-chevron { color: #fff9e8; }
.dark #exchange:disabled, .dark #setting-switch, .dark footer { color: dark-muted; }
.dark #hint_message { color: #ffd2bd; }
.dark :focus-visible { outline-color: saffron; }

@media (prefers-reduced-motion: reduce) { #exchange, #setting-switch { transition: none !important; } }
