@import '../common/style/input.styl';

@font-face {
    font-family: 'translateIcon';
    src: url('~/iconfont.eot?t=1531409630632');
    /* IE9 */
    src: url('~/iconfont.eot?t=1531409630632#iefix') format('embedded-opentype'), url('data:application/x-font-woff;charset=utf-8;base64,') format('woff'), url('~/iconfont.ttf?t=1531409630632') format('truetype'), url('~/iconfont.svg?t=1531409630632#iconfont') format('svg');
    /* iOS 4.1- */
}

// 시스템 기본 폰트 스택 적용 (아이콘 폰트 제외)
html, body, input, select, button, textarea
	font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, "Helvetica Neue", Arial, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", sans-serif
	-webkit-font-smoothing: antialiased
	-moz-osx-font-smoothing: grayscale
	font-variant-ligatures: none
	font-weight: 500

lotus-bg = #f2ecbc;
lotus-surface = #f7f3d0;
lotus-border = #c9c19f;
lotus-text = #545464;
lotus-muted = #716e61;
lotus-subtle = #8a8980;
lotus-accent = #4d699b;
lotus-accent-soft = #dcd4ad;
lotus-danger = #c84053;
color-primary = lotus-accent;
tokyo-bg = #222436;
tokyo-bg-dark = #1e2030;
tokyo-surface = #2a2e45;
tokyo-surface-hover = #2f334d;
tokyo-border = #3b4261;
tokyo-text = #c8d3f5;
tokyo-muted = #b4c0e8;
tokyo-subtle = #828bb8;
tokyo-accent = #82aaff;
tokyo-accent-soft = #31406b;
tokyo-danger = #ff757f;

.translate-icon {
    font-family: 'translateIcon' !important;
    font-size: 20px;
    font-style: normal;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

.translate-icon-exchange::before {
    content: '\e8f8';
}

.translate-icon-arrow-up::before {
    content: '\e695';
}

.translate-icon-arrow-down::before {
    content: '\e606';
}

.set {
    font-size: 30px;
    font-weight: bolder;
    position: relative;
    bottom: 6px;
    height: 30px;
}

#arrow-up {
    display: none;
}

#exchange {
    color: color-primary;
}

#exchange:active {
    color: grey;
}

html, body {
    max-width: 440px;
    min-width: 350px;
    overflow: hidden;
    background-color: lotus-bg;
    color: lotus-text;
}

.frame {
    margin: 5%;
    background-color: lotus-bg;
}

.row {
    display: flex;
    align-items: center;
    justify-content: space-around;
    margin: 2% 0;
    line-height: 4em;
}

.col {
    flex: 1 0 50%;
}

.selection {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.switch-label {
    display: block;
    font-size: medium;
    text-align: center;
}

select {
    width: 90%;
    max-width: 150px;
    height: 25px;
    background-color: lotus-surface;
    color: lotus-text;
    border: 1px solid lotus-border;
    border-radius: 6px;
}

footer {
    font-size: xx-small;
    color: lotus-subtle;
    text-align: center;

    a {
        color: lotus-accent;
    }
}

.multiple {
    flex: 1 1 60%;
    display: inline-block;
}

.select {
    background-color: lotus-surface;
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
}

.option {
    line-height: 20px;
}

i {
    max-height: 35px;
}

#translate_input {
    flex: 1 3 75%;
    height: 20px;
    border: color-primary solid 1px;
    background-color: lotus-surface;
    color: lotus-text;
    border-radius: 8px;

    &:focus {
        outline: color-primary solid 1px;
        box-shadow: 0 0 0 2px rgba(77, 105, 155, 0.14);
    }
}

#translateSubmit {
    height: 26px;
    flex: 3 1 20%;
    background-color: color-primary;
    color: lotus-bg;
    border-style: solid;
    border-color: color-primary;
    border-radius: 8px;
    margin-left: 5%;
}

#hint_message {
    color: lotus-danger;
    display: none;
}

#setting-switch {
    cursor: pointer;
    margin-top: 5%;
    height: 20 px;
    color: lotus-subtle;
    justify-content: center;
}

#setting-switch:hover {
    color: lotus-text;
}

#setting {
    display: none;
    margin: 7% 0;
}

#page-translate {
    margin-top: 10%;
    font-size: medium;

    a {
        line-height: 1em;
        color: color-primary;
        padding: 0 2%;
        user-select: none;
    }

    a:hover {
        cursor: pointer;
    }

    a:active {
        color: skyblue;
    }
}

// Dark Mode Styles
.dark {
    background-color: tokyo-bg !important;
    color: tokyo-text !important;
}

.dark .frame {
    background-color: tokyo-bg !important;
}

.dark #translate_input {
    background-color: tokyo-surface !important;
    color: tokyo-text !important;
    border-color: tokyo-border !important;
}

.dark #translate_input:focus {
    outline-color: tokyo-accent !important;
    box-shadow: 0 0 0 2px rgba(122, 162, 247, 0.18) !important;
}

.dark #translateSubmit {
    background-color: tokyo-accent !important;
    border-color: tokyo-accent !important;
    color: tokyo-bg-dark !important;
}

.dark select {
    background-color: tokyo-surface !important;
    color: tokyo-text !important;
    border-color: tokyo-border !important;
}

.dark .switch-label {
    color: tokyo-muted !important;
}

.dark #setting-switch {
    color: tokyo-subtle !important;
}

.dark #setting-switch:hover {
    color: tokyo-text !important;
}

.dark #exchange {
    color: tokyo-accent !important;
}

.dark #page-translate a {
    color: tokyo-accent !important;
}

.dark footer {
    color: tokyo-subtle !important;
}

.dark #hint_message {
    color: tokyo-danger !important;
}

.dark .switch {
    border-color: tokyo-border !important;
    background: tokyo-border !important;
}

.dark .switch:before {
    background-color: tokyo-border !important;
}

.dark .switch:after {
    background-color: tokyo-text !important;
    box-shadow: none !important;
}

.dark .switch:checked {
    border-color: tokyo-accent !important;
    background-color: tokyo-accent !important;
}

.dark .switch:checked:before {
    background-color: tokyo-accent-soft !important;
}
