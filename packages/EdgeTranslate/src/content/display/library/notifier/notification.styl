/**
 * style for notification items
 */
final-opacity = 0.95;
animation-duration = 400ms;

.edge-translate-notifier-item {
	display: flex;
	flex-direction: row;
	justify-content: center;
	align-items: flex-start;
	box-sizing: border-box;
	width: 440px;
	max-width: calc(100vw - 32px);
	padding: 14px 16px;
	margin: 1.5vh 0;
	pointer-events: all;
	border-radius: 12px;
	background-color: #fff9e8;
	color: #2b251a;
	border: 1px solid #6b5b38;
	box-shadow: 0 6px 18px 0 rgba(11, 26, 41, 0.2);
	opacity: final-opacity;
}

.edge-translate-notifier-success {
	background-color: #fff9e8;
	border-left: 5px solid #24613a;
}

.edge-translate-notifier-info {
	background-color: #fff9e8;
	border-left: 5px solid #17324d;
}

.edge-translate-notifier-warning {
	background-color: #fff9e8;
	border-left: 5px solid #8a5b00;
}

.edge-translate-notifier-error {
	background-color: #fff9e8;
	border-left: 5px solid #a9471d;
}

.edge-translate-notifier-icon {
	font-size: 20px;
	color: currentColor;
	margin-right: 12px;
	position: relative;
	top: 3px;
}

.edge-translate-notifier-content {
	height: 100%;
	display: flex;
	flex-direction: column;
	justify-content: flex-start;
	align-items: flex-start;
}

.edge-translate-notifier-title {
	font-size: 16px;
	font-weight: 600;
}

.edge-translate-notifier-detail {
	font-size: 14px;
	padding-top: 6px;
}

.edge-translate-notifier-close {
	cursor: pointer;
	border: 0;
	padding: 4px;
	background: transparent;
	color: inherit;
	font-size: 16px;
	margin-left: 12px;
	position: relative;
	top: 6px;
	color: #655a43;

	:hover {
		color: #2b251a;
	}

	svg { width: 20px; height: 20px; stroke-width: 2; }
}

.edge-translate-notifier-close:focus-visible {
	outline: 3px solid #a9471d;
	outline-offset: 3px;
	border-radius: 4px;
}

.edge-translate-notifier-show-animation {
	animation-name: edge-translate-notifier-show-animation;
	animation-duration: animation-duration;
	animation-timing-function: cubic-bezier(0.45, 1.45, 0.75, 1);
}

.edge-translate-notifier-disappear-animation {
	animation-name: edge-translate-notifier-disappear-animation;
	animation-duration: animation-duration;
	animation-timing-function: ease;
}

@keyframes edge-translate-notifier-show-animation {
	from {
		transform: translate(0, -30px) scale(0.75);
		opacity: 0;
	}

	to {
		transform: translate(0, 0) scale(1);
		opacity: final-opacity;
	}
}

@keyframes edge-translate-notifier-disappear-animation {
	from {
		transform: translate(0, 0) scale(1);
		opacity: final-opacity;
	}

	to {
		transform: translate(0, -30px) scale(0.75);
		opacity: 0;
	}
}

@media (prefers-reduced-motion: reduce) {
	.edge-translate-notifier-show-animation, .edge-translate-notifier-disappear-animation { animation: none !important; }
}
