color-primary = #a9471d;

#notice {
	box-sizing: border-box;
	max-width: 900px;
	padding: 24px 5%;
	margin: 0 auto;
	color: #2b251a;
	font: 400 16px/1.55 system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang TC", "Microsoft JhengHei", "Noto Sans TC", sans-serif;
}
body { margin: 0; background: #fff0cc; }

header {
	width: 100%;
	min-height: 56px;
	color: color-primary;
	display: flex;
	align-items: center;
	gap: 12px;
	font-size: 24px;
	font-weight: 700;
	img { width: 48px; height: 48px; }
}

h1 { font-size: 24px; line-height: 1.3; }
h2 { font-size: 18px; line-height: 1.4; }

ol {
	padding-left: 1.5em;
	line-height: 1.6;
}

ul {
	padding: 0 15px;
	line-height: 1.6;

	li {
		font-size: 16px;
	}
}

a {
	color: color-primary;
	text-underline-offset: 2px;
}

:focus-visible { outline: 3px solid #a9471d; outline-offset: 3px; }
