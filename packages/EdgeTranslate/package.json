{
  "name": "edge_translate",
  "version": "3.4.6",
  "private": true,
  "scripts": {
    "test": "jest",
    "format": "eslint 'src/**/*.js' 'config/**/*.js' --fix",
    "dev:chrome": "gulp dev --browser chrome",
    "dev:firefox": "gulp dev --browser firefox",
    "dev:safari": "gulp devSafariXcode --browser safari",
    "build:chrome": "gulp build --browser chrome",
    "build:firefox": "gulp build --browser firefox",
    "build:safari": "gulp build --browser safari && npm run safari:rsync",
    "pack:chrome": "gulp pack --browser chrome",
    "pack:firefox": "gulp pack --browser firefox",
    "safari:rsync": "rsync -av --delete ./build/safari/ \"./safari-xcode/EdgeTranslate/EdgeTranslate Extension/Resources/\"",
    "e2e:chrome": "SELENIUM_BROWSER=chrome jest -i --config './test/e2e/jest/jest.config.js'",
    "e2e:firefox": "SELENIUM_BROWSER=firefox jest -i --config './test/e2e/jest/jest.config.js'",
    "build:parallel": "sh -c '(gulp pack --browser chrome) & (gulp pack --browser firefox) & (gulp build --browser safari && npm run safari:rsync) & wait'",
    "build": "npm run build:parallel",
    "safari:archive": "xcodebuild -project safari-xcode/EdgeTranslate/EdgeTranslate.xcodeproj -scheme EdgeTranslate -configuration Release -archivePath safari-xcode/build/EdgeTranslate.xcarchive archive",
    "safari:export": "xcodebuild -exportArchive -archivePath safari-xcode/build/EdgeTranslate.xcarchive -exportOptionsPlist safari-xcode/ExportOptions.plist -exportPath safari-xcode/build/export",
    "safari:upload": "xcrun altool --upload-app -f 'safari-xcode/build/export/EdgeTranslate.pkg' -t macos -u $APPLE_ID -p $APP_SPEC_PASS",
    "safari:release": "npm run build:safari && npm run safari:archive && npm run safari:export && npm run safari:upload"
  },
  "devDependencies": {
    "@babel/core": "^7.17.7",
    "@babel/eslint-parser": "^7.17.0",
    "@babel/plugin-transform-react-jsx": "^7.17.3",
    "@babel/preset-env": "^7.16.11",
    "@svgr/webpack": "^5.4.0",
    "adm-zip": "^0.6.1",
    "axios": "^1.21.0",
    "babel-loader": "^8.2.3",
    "chromedriver": "^156.0.2",
    "crypto": "^1.0.1",
    "css": "^2.2.1",
    "del": "^6.0.0",
    "eslint-config-preact": "^1.3.0",
    "eslint-plugin-html": "^6.2.0",
    "geckodriver": "^8.0.0",
    "gulp": "^5.0.1",
    "gulp-eslint": "^5.0.0",
    "gulp-stylus": "^2.5.0",
    "gulp-terser": "^2.1.0",
    "gulp-zip": "^5.1.0",
    "jest": "^25.1.0",
    "jest-chrome": "^0.7.0",
    "jest-image-snapshot": "^4.5.1",
    "jest-raw-loader": "^1.0.1",
    "lodash": "^4.17.21",
    "merge-stream": "^2.0.0",
    "minimist": "^1.2.6",
    "mockttp": "^4.6.5",
    "querystring": "^0.2.1",
    "raw-loader": "^4.0.2",
    "selenium-webdriver": "^4.1.1",
    "webpack": "^5.70.0",
    "webpack-merge": "^5.8.0",
    "webpack-stream": "^7.0.0"
  },
  "dependencies": {
    "@commitlint/cli": "21.2.4",
    "@edge_translate/translators": "^0.1.4",
    "dompurify": "^3.4.17",
    "jest-environment-jsdom": "30.5.2",
    "lucide-preact": "^1.61.0",
    "pdfjs-dist": "^5.4.54",
    "preact": "^10.6.6",
    "preact-render-to-string": "^5.1.20",
    "react-draggable": "^4.5.0",
    "react-shadow": "^20.6.0",
    "react-use": "^17.3.2",
    "resize-observer-polyfill": "^1.5.1",
    "simplebar-react": "^2.3.6",
    "styled-components": "5.3.0",
    "ts-jest": "25.5.1",
    "turbo": "2.11.10",
    "vite": "8.3.5"
  },
  "jest": {
    "verbose": true,
    "testEnvironment": "jsdom",
    "testRegex": "(/test/unit/.*\\.(test|spec))\\.(ts|tsx|js)$",
    "testTimeout": 10000,
    "transform": {
      "^.+\\.[t|j]sx?$": "babel-jest",
      "\\.(css|less)$": "jest-raw-loader"
    },
    "moduleDirectories": [
      "node_modules",
      "src"
    ],
    "setupFilesAfterEnv": [
      "./test/unit/jest.setup.js"
    ]
  }
}
